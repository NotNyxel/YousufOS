{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YousufOS",
  "mainBinaryName": "yousufos",
  "version": "1.7.0",
  "identifier": "com.nyxel.yousufos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YousufOS",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "decorations": false,
        "resizable": true,
        "focus": true,
        "backgroundColor": "#07080b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPCACHE/**",
          "/media/**",
          "/mnt/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "Islamic-focused Smart TV launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "playerctl",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "mpv",
          "pulseaudio-utils | wireplumber",
          "ffmpeg",
          "pkexec | policykit-1"
        ]
      }
    }
  }
}
